dbt_tutorial:
  target: dev

  outputs:
    dev:
      type: databricks
      host: "{{ env_var('DATABRICKS_HOST') }}"
      http_path: "{{ env_var('DATABRICKS_HTTP_PATH') }}"
      catalog: dev_yuvraj_gurav
      schema: analytics
      auth_type: oauth
      token: "{{ env_var('DATABRICKS_TOKEN') }}"
      threads: 4

    qa:
      type: databricks
      host: "{{ env_var('DATABRICKS_HOST') }}"
      http_path: "{{ env_var('DATABRICKS_HTTP_PATH') }}"
      catalog: qa
      schema: analytics
      auth_type: oauth
      token: "{{ env_var('DATABRICKS_TOKEN') }}"
      threads: 4

    prod:
      type: databricks
      host: "{{ env_var('DATABRICKS_HOST') }}"
      http_path: "{{ env_var('DATABRICKS_HTTP_PATH') }}"
      catalog: prod
      schema: analytics
      auth_type: oauth
      token: "{{ env_var('DATABRICKS_TOKEN') }}"
      threads: 4
